{
  "manifest_version": 3,
  "name": "Chat-a-logue",
  "version": "1.0.0",
  "description": "Got tired of limited exports on other extensions so built one to export ChatGPT, Claude, and Gemini chats to Markdown or Gruvbox-Themed PDFs.",
  "permissions": ["activeTab"],
  "host_permissions": ["https://chatgpt.com/*", "https://gemini.google.com/*", "https://claude.ai/*"],
  "action": {
    "default_popup": "popup.html"
  },
  "content_scripts": [
    {
      "matches": ["https://chatgpt.com/*", "https://gemini.google.com/*", "https://claude.ai/*"],
      "js": ["turndown.js", "content.js"]
    }
  ],
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
